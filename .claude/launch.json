{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "desktop-web",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": [
        "-c",
        "export PATH=$HOME/.nvm/versions/node/v26.6.0/bin:$PATH && cd apps/desktop && npx vite --port 1420 --strictPort"
      ],
      "port": 1420
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": [
        "-c",
        "export PATH=$HOME/.nvm/versions/node/v26.6.0/bin:$PATH && cd apps/mobile && CI=1 npx expo start --web --port 8082 --clear"
      ],
      "port": 8082
    }
  ]
}